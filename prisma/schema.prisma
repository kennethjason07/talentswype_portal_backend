generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CandidateStatus {
  PENDING
  INVITED
  INTERVIEW_STARTED
  INTERVIEW_COMPLETED
  SCORED
  SHORTLISTED
}

enum InterviewStatus {
  CREATED
  INVITED
  STARTED
  COMPLETED
  SCORED
}

enum InterviewType {
  FOUNDATIONAL
  FOLLOW_UP
}

model Candidate {
  id             String              @id @default(uuid())
  email          String              @unique
  firstName      String
  lastName       String
  phone          String?
  resumeUrl      String?
  status         CandidateStatus     @default(PENDING)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  interviews     Interview[]
  shortlists     JobShortlist[]
  notifications  HrNotification[]
}

model Interview {
  id                    String               @id @default(uuid())
  candidateId           String
  type                  InterviewType
  flowmingoInterviewSet String
  flowmingoCandidateId  String?
  invitationSentAt      DateTime?
  status                InterviewStatus      @default(CREATED)
  jobId                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  candidate             Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  result                InterviewResult?
  video                 VideoMetadata?
  followUps             InterviewFollowUp[]

  @@unique([candidateId, type], map: "unique_foundational_interview")
  @@index([candidateId])
  @@index([jobId])
  @@index([flowmingoCandidateId])
}

model InterviewResult {
  id                String    @id @default(uuid())
  interviewId       String    @unique
  evaluationType    String
  overallScore      Decimal?  @db.Decimal(4, 2)
  rawScore          Json?
  submittedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  interview         Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model VideoMetadata {
  id              String    @id @default(uuid())
  interviewId     String    @unique
  videoUrl        String?
  submissionUrl   String?
  durationSeconds Int?
  thumbnailUrl    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  interview       Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model InterviewFollowUp {
  id          String    @id @default(uuid())
  interviewId String
  question    String
  createdAt   DateTime  @default(now())
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

model JobShortlist {
  id             String    @id @default(uuid())
  jobId          String
  candidateId    String
  shortlistedBy  String
  notes          String?
  createdAt      DateTime  @default(now())
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([jobId])
}

model HrNotification {
  id           String    @id @default(uuid())
  hrUserId     String
  candidateId  String
  jobId        String?
  type         String
  message      String
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([hrUserId])
  @@index([jobId])
}

model WebhookEvent {
  id           String    @id @default(uuid())
  provider     String
  providerEventId String @unique
  eventName    String
  payload      Json
  createdAt    DateTime  @default(now())
}
