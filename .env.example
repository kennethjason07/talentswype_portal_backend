# ========================================
# SERVER CONFIGURATION
# ========================================
APP_PORT=8020
APP_BASE_URL=http://localhost:8020
APP_NODE_ENV=development
APP_LOG_LEVEL=info



# ========================================
# SECURITY & AUTHENTICATION
# ========================================
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# ========================================
# OAUTH - GOOGLE (Optional)
# ========================================
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SERVER_BASE_URL=http://localhost:8020

# ========================================
# OAUTH - LINKEDIN (Optional)
# ========================================
# Get credentials from: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ========================================
# EMAIL SERVICE (Optional)
# ========================================
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
EMAIL_USER=
EMAIL_PASS=

# ========================================
# SMS SERVICE - TWILIO (Optional)
# ========================================
# Get credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ========================================
# PAYMENT - PAYPAL (Optional)
# ========================================
# Get credentials from: https://developer.paypal.com/
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ========================================
# CLIENT/FRONTEND
# ========================================
CLIENT_BASE_URL=http://localhost:3000
